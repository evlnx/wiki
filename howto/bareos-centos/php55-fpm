# crear directorios para el socket y arreglar permisos.
mkdir /run/php55-php-fpm
chown nginx:nginx /run/php55-php-fpm/
chmod 2770 /run/php55-php-fpm

# configurar PHP-FPM para usar sockets
sed -ri 's@^listen =.*$@listen = /run/php55-php-fpm/php55-fpm.sock@' /opt/rh/php55/root/etc/php-fpm.d/www.conf

# arreglar dueño, grupo y modo
sed -ri 's@^;listen.owner =.*$@listen.owner = nginx@' /opt/rh/php55/root/etc/php-fpm.d/www.conf
sed -ri 's@^;listen.group =.*$@listen.group = nginx@' /opt/rh/php55/root/etc/php-fpm.d/www.conf
sed -ri 's@^;listen.mode =.*$@listen.mode = 660@' /opt/rh/php55/root/etc/php-fpm.d/www.conf


